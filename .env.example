# Keys the code uses (app/core/config.py)
GROQ_API_KEY=
TAVILY_API_KEY=
PINECONE_API_KEY=

PINECONE_INDEX_NAME=appliance-support-kb
PINECONE_NAMESPACE=appliance-kb
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Pinecone-hosted embedding model (1024 dims)
EMBEDDING_MODEL=multilingual-e5-large
TOP_K=4
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=20
MAX_RETRIES=1

# Protects POST /api/ingest (sent as the X-Admin-Key header)
ADMIN_API_KEY=change-me

# Public deployment only (set in render.yaml): uploads off, usage limits on
# PUBLIC_DEMO=true
# DEMO_QUESTIONS_PER_IP_PER_HOUR=10
# DEMO_QUESTIONS_PER_DAY=60
